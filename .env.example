# development / test / production
LOGGINGX_AI_ENVIRONMENT=development
# loggingx-java 调用时放在 X-API-Key 请求头里的密钥；production 必填
LOGGINGX_AI_API_KEY=

# DeepSeek（https://platform.deepseek.com）
LOGGINGX_AI_DEEPSEEK_API_KEY=
LOGGINGX_AI_DEEPSEEK_BASE_URL=https://api.deepseek.com
LOGGINGX_AI_DEEPSEEK_MODEL=deepseek-chat

# 通义千问（阿里云百炼 DashScope，OpenAI 兼容模式）
LOGGINGX_AI_QWEN_API_KEY=
LOGGINGX_AI_QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
LOGGINGX_AI_QWEN_MODEL=qwen-plus

# 各 agent 使用的模型，格式 provider:model；某个提供方没配密钥时自动换用另一个
LOGGINGX_AI_LOG_ANALYST_MODEL=deepseek:deepseek-chat
LOGGINGX_AI_CODE_ANALYST_MODEL=qwen:qwen3-coder-plus
LOGGINGX_AI_ROOT_CAUSE_MODEL=deepseek:deepseek-chat
LOGGINGX_AI_FIXER_MODEL=qwen:qwen3-coder-plus
LOGGINGX_AI_REVIEWER_MODEL=qwen:qwen-plus

LOGGINGX_AI_TEMPERATURE=0.2
LOGGINGX_AI_REQUEST_TIMEOUT=120
LOGGINGX_AI_MAX_RETRIES=2
# 评审不通过时最多让修复 agent 重做几次
LOGGINGX_AI_MAX_REVIEW_ROUNDS=1

# loggingx-java 的代码仓库目录（loggingx.ai.repo-dir，里面是 store-<日志库 ID>）。
# 请求里没有带代码时，按 storeId 到这里找堆栈对应的文件；与 loggingx-java 不在同一台机器时留空。
LOGGINGX_AI_REPO_ROOT=
LOGGINGX_AI_MAX_CODE_REFS=5
LOGGINGX_AI_CODE_CONTEXT_LINES=30
LOGGINGX_AI_MAX_CODE_CHARS=24000
